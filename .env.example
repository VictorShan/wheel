# Copy to .env and fill in. Every variable here is validated at startup by src/env.js.

# DynamoDB. In production the credentials come from the deploy environment's role; locally, run
# `npm run ddb:local` and point DDB_ENDPOINT at it, then `npm run ddb:create-table`.
AWS_REGION="us-east-1"
DDB_TABLE_NAME="wheel"
# DDB_ENDPOINT="http://127.0.0.1:4567"   # local DynamoDB only - leave unset in production
# AWS_ACCESS_KEY_ID="local"              # any value works against a local DynamoDB
# AWS_SECRET_ACCESS_KEY="local"

# Clerk authentication (https://clerk.com). Creating a wheel, adding items and voting need a user.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Soketi / Pusher-compatible realtime server, used to broadcast spins and item changes to everyone
# viewing a wheel. The app still works without it - changes just don't reach other devices live.
NEXT_PUBLIC_SOKETI_URL=""
NEXT_PUBLIC_SOKETI_KEY=""
SOKETI_APP_ID=""
SOKETI_SECRET=""

# Only needed to run `npm run ddb:migrate-from-turso`, which copies the pre-DynamoDB data across.
# TURSO_DATABASE_URL=""
# TURSO_AUTH_TOKEN=""
