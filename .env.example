# Copy to .env and fill in. Every variable here is validated at startup by src/env.js.

# Turso / libSQL database (https://turso.tech). A local file works for development:
# TURSO_DATABASE_URL="file:./local.db"
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Clerk authentication (https://clerk.com). Creating a lobby, adding items and voting need a user.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Soketi / Pusher-compatible realtime server, used to broadcast spins and item changes to everyone
# viewing a lobby. The app still works without it - changes just don't reach other devices live.
NEXT_PUBLIC_SOKETI_URL=""
NEXT_PUBLIC_SOKETI_KEY=""
SOKETI_APP_ID=""
SOKETI_SECRET=""
